<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Laundry Connect</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <!-- JS MODULE (WAJIB URUT) -->
  <script src="js/api.js" defer></script>
  <script src="js/auth.js"></script>
  <script src="js/ui.js"></script>
  <script src="js/dashboard.js" defer></script>
  <script src="js/transaksi.js" defer></script>
  <script src="js/customer.js" defer></script>

  <script>
    window.addEventListener("DOMContentLoaded", () => {
      if (localStorage.getItem("u")) {
        loadDashboard();
        loadCustomers();
        loadTransactions();
      }
    });
  </script>
</head>

<body class="bg-gray-100">

<!-- ================= LOGIN ================= -->
<div id="loginView" class="flex h-screen">
  <div class="hidden md:flex w-1/2 bg-gradient-to-br from-cyan-700 to-teal-500 text-white p-10 flex-col justify-center">
    <h1 class="text-4xl font-bold mb-4">Laundry Connect</h1>
    <p>Manajemen laundry modern</p>
  </div>

  <div class="flex w-full md:w-1/2 items-center justify-center">
    <div class="bg-white p-8 rounded-2xl shadow w-80">
      <input id="email" class="w-full mb-3 p-3 border rounded-xl" placeholder="Email">
      <input id="password" type="password" class="w-full mb-3 p-3 border rounded-xl" placeholder="Password">

      <button onclick="doLogin()" class="w-full bg-teal-600 text-white p-3 rounded-xl">
        Login
      </button>
    </div>
  </div>
</div>

<!-- ================= APP ================= -->
<div id="appView" class="hidden flex">

  <!-- SIDEBAR -->
  <div class="w-64 bg-white shadow min-h-screen">
    <div class="p-5 font-bold text-teal-600">Laundry Connect</div>

    <div class="p-4 space-y-2">
      <button onclick="showPage('dashboard')" class="block w-full text-left">Dashboard</button>
      <button onclick="showPage('transaksi')" class="block w-full text-left">Data Cucian</button>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="flex-1 p-6">

    <!-- DASHBOARD -->
    <div id="pageDashboard">
      <h2 class="text-2xl font-bold mb-4">Dashboard</h2>

      <button onclick="openCucian()" class="bg-teal-600 text-white px-4 py-2 rounded-lg">
        + Cucian Baru
      </button>

      <div id="dashboardContent"></div>
    </div>

    <!-- TRANSAKSI -->
    <div id="pageTransaksi" class="hidden">
      <h2 class="text-2xl font-bold mb-4">Data Cucian</h2>

      <table class="w-full bg-white">
        <thead>
          <tr>
            <th>Kode</th>
            <th>Nama</th>
            <th>Status</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody id="tbodyTransaksi"></tbody>
      </table>
    </div>

  </div>
</div>

</body>
</html>
